{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-result.schema.json",
  "title": "bella-tracking agent task result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "stage", "status", "artifacts", "issues"],
  "properties": {
    "version": { "const": "1.0" },
    "stage": { "enum": ["menu", "A", "B", "C", "D", "E", "F", "7", "H"] },
    "status": { "enum": ["completed", "blocked", "needs_user_input", "failed"] },
    "nextAction": { "enum": ["none", "choose_entry", "confirm_event", "confirm_full_page", "choose_device", "choose_repair_mode", "fix_validation", "retry"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["events", "adaptor", "impl", "landing_html", "review_html", "accept_chain", "accept_json", "accept_html", "final_html", "workflow", "diagnostic", "missing_list"] },
          "path": { "type": "string" }
        }
      }
    },
    "nextTask": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "stage", "executor", "status"],
      "properties": {
        "id": { "type": "string" },
        "stage": { "enum": ["A", "B", "C", "D", "E", "F", "7", "H"] },
        "executor": { "enum": ["script", "agent", "user"] },
        "status": { "enum": ["ready", "blocked"] },
        "subject": { "type": "object" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "completionCondition": { "type": "array", "items": { "type": "string" } },
        "blockingReason": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "prompt": { "type": ["string", "null"] },
        "nextAction": { "enum": ["none", "choose_entry", "confirm_event", "confirm_full_page", "choose_device", "choose_repair_mode", "fix_validation", "retry"] }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "evtId": { "type": "string" },
          "field": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
