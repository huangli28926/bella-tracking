{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "impl.schema.json",
  "title": "Tracking implementation document",
  "type": "object",
  "required": ["events"],
  "properties": {
    "generatedAt": { "type": "string" },
    "excelPath": { "type": "string" },
    "slug": { "type": "string" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["evtId"],
      "not": { "required": ["uicode"] },
      "properties": {
        "evtId": { "type": "string" },
        "status": { "enum": ["pending", "existing", "located", "unresolved"] },
        "accepted": { "type": "boolean" },
        "confirmed": { "type": "boolean" },
        "targetFile": { "type": "string" },
        "functionName": { "type": "string" },
        "lifecycle": { "enum": ["onClick", "useEffect", "IntersectionObserver", "pageLoad", ""] },
        "pageKey": { "type": "string" },
        "styleId": { "type": "string" },
        "entryUrlTemplate": { "type": "string" },
        "insertHint": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "uicodeConflict": { "type": "string" },
        "code": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "accept": { "$ref": "#/$defs/accept" },
        "unresolved": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(请确认埋点位置|请确认参数 .+ 的取值)$" }
        },
        "resolution": { "$ref": "#/$defs/reservedResolution" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string" },
        "docDesc": { "type": "string" },
        "required": { "type": "boolean" },
        "expression": { "type": "string" },
        "valueKind": { "enum": ["expression", "prompt", ""] },
        "sourcePath": {
          "type": ["string", "array"],
          "items": { "type": "string" }
        },
        "confidence": { "enum": ["high", "medium", "low", ""] },
        "sourceUniqueness": { "enum": ["unique", "multiple", "unknown"] },
        "pathUniqueness": { "enum": ["unique", "multiple", "unknown"] },
        "parameterImplementable": { "type": "boolean" },
        "selectedBand": { "type": ["number", "null"] },
        "preferredCandidateId": { "type": "string" },
        "scanIntegrity": { "enum": ["ok", "invalid"] },
        "unresolvedCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidates": { "type": "array" },
        "acquisition": { "type": "object" },
        "legacyUnverified": { "type": "boolean" },
        "unresolved": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transform": {
          "type": "object",
          "properties": {
            "kind": { "type": "string" },
            "evidence": {
              "type": "array",
              "items": { "$ref": "#/$defs/parameterEvidence" }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterEvidence" }
        },
        "scopeReachable": { "type": ["boolean", "null"] },
        "conflicts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hint": {
          "type": "object",
          "properties": {
            "images": {
              "type": "array",
              "items": { "type": "string" }
            },
            "note": { "type": "string" },
            "api": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "field": { "type": "string" }
              }
            }
          }
        },
        "confirmation": { "$ref": "#/$defs/parameterConfirmation" },
        "resolution": { "$ref": "#/$defs/reservedResolution" }
      }
    },
    "reservedResolution": {
      "type": "object",
      "description": "Reserved for a later resolution model. Fixbug1 MVP does not require or consume this object.",
      "additionalProperties": true
    },
    "parameterConfirmation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["unconfirmed", "confirmed", "reused", "stale"]
        },
        "source": {
          "enum": ["human", ""]
        },
        "reuseScope": {
          "enum": ["exact-target", "same-dataflow", "none"]
        },
        "confirmedAt": {
          "type": ["string", "null"]
        },
        "invalidReason": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "parameterKey": { "type": "string" },
            "sourceRoot": { "type": "string" },
            "targetFile": { "type": ["string", "null"] },
            "targetSymbol": { "type": ["string", "null"] },
            "componentBoundary": { "type": ["string", "null"] },
            "lifecycle": { "type": ["string", "null"] },
            "semanticFingerprint": { "type": ["string", "null"] },
            "transformKind": { "type": ["string", "null"] }
          }
        },
        "reuseChecks": {
          "type": "object",
          "properties": {
            "parameterIdentity": { "type": "boolean" },
            "sourceIdentity": { "type": "boolean" },
            "scopeReachable": { "type": "boolean" },
            "targetCompatible": { "type": "boolean" },
            "componentBoundaryCompatible": { "type": "boolean" },
            "lifecycleCompatible": { "type": "boolean" },
            "transformationCompatible": { "type": "boolean" },
            "currentEvidencePresent": { "type": "boolean" }
          }
        }
      }
    },
    "parameterEvidence": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "same-component-tracking",
            "same-page-tracking",
            "same-module-tracking",
            "jsx-binding",
            "api-field",
            "prop-chain",
            "state-chain",
            "hook-chain",
            "context-chain",
            "url-field",
            "user-context",
            "field-memory",
            "repository-convention",
            "manual-confirm",
            "local-binding",
            "component-reference",
            "ui-object-match",
            "variable-name-similarity",
            "historical-pattern"
          ]
        },
        "file": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "expression": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "accept": {
      "type": "object",
      "not": {
        "properties": {
          "expect": { "required": ["uicode"] }
        }
      },
      "properties": {
        "trigger": { "$ref": "#/$defs/trigger" },
        "navigatesAway": { "type": "boolean" },
        "assertParams": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dataDeps": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataDep" }
        },
        "candidatePaths": {
          "type": "array",
          "items": { "type": "object" }
        },
        "pathResolution": { "$ref": "#/$defs/pathResolution" },
        "seedUrlKey": { "type": "string" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["click", "scrollIntoView", "waitVisible", "pageLoad"] },
        "by": { "enum": ["text", "testid", "css", "role", ""] },
        "value": { "type": "string" },
        "alternates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preconditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["click", "scrollIntoView", "waitVisible", "waitApi", "waitUrl", "pageLoad"] },
        "by": { "enum": ["text", "testid", "css", "role", ""] },
        "value": { "type": "string" },
        "alternates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "urlIncludes": { "type": "string" },
        "why": { "type": "string" }
      }
    },
    "runtimeSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["windowPath"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "dataDep": {
      "type": "object",
      "required": ["paramKey", "from", "status", "unresolved"],
      "properties": {
        "paramKey": { "type": "string", "minLength": 1 },
        "from": { "enum": ["api", "url", "user", "page"] },
        "queryKey": { "type": "string" },
        "expression": { "type": "string" },
        "sourcePath": { "type": "string" },
        "api": {
          "type": "object",
          "properties": {
            "urlIncludes": { "type": "string" },
            "field": { "type": "string" },
            "map": {
              "type": "object",
              "description": "Map API leaf values to reported enum values. Keys are matched case-insensitively."
            },
            "default": {
              "description": "Used when the leaf is empty or not present in map."
            }
          }
        },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": { "$ref": "#/$defs/runtimeSelector" }
          }
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": { "$ref": "#/$defs/runtimeSelector" }
          }
        },
        "status": { "enum": ["resolved", "needsConfirm"] },
        "unresolved": {
          "type": "array",
          "items": {
            "enum": [
              "MISSING_QUERY_KEY",
              "MISSING_API_URL",
              "MISSING_API_FIELD",
              "MISSING_USER_RUNTIME_SELECTOR",
              "MISSING_PAGE_RUNTIME_SELECTOR",
              "UNSUPPORTED_RUNTIME_SELECTOR",
              "SOURCE_UNRESOLVED",
              "PAGE_SOURCE_UNRESOLVED"
            ]
          }
        }
      }
    },
    "pathResolution": {
      "type": "object",
      "properties": {
        "status": { "enum": ["resolved", "needsConfirm"] },
        "selectedPathId": { "type": "string" },
        "selectedBy": {
          "enum": ["current-change", "historical-human-decision", "unique-candidate", "deterministic-tie-break", "human", ""]
        },
        "candidateSignature": { "type": "string" },
        "decision": {
          "type": "object",
          "properties": {
            "source": { "enum": ["deterministic-rule", "human", ""] },
            "reason": { "type": "string" },
            "validity": { "enum": ["valid", "stale", "invalid", "superseded", ""] },
            "context": { "type": "object" }
          }
        },
        "unresolved": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
